# ==============================================================================
# VTU Smart Attendance System - Environment Configuration Template
# ==============================================================================

# 1. Database Configuration
# MongoDB Atlas connection string.
# If omitted or offline, the server falls back automatically to local persistent JSON (.local_db/vtu_attendance_store.json).
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vtu_attendance?retryWrites=true&w=majority"

# 2. Authentication & Session Security
# Cryptographic secret used to sign and verify JWT authentication tokens & HTTP-only cookies
JWT_SECRET="vtu-smart-attendance-institutional-secret-2026-secure-key"

# 3. Biometric & Facial Verification Cryptographic Keys
# 256-bit AES-GCM key used to encrypt all stored facial embeddings at rest
BIOMETRIC_ENCRYPTION_KEY="vtu-secure-biometric-arcface-aes256-gcm-key-2026"

# HMAC signing secret for one-time anti-replay QR verification session tokens
VERIFICATION_SESSION_SECRET="vtu-verification-session-anti-replay-hmac-key-2026"

# Signature secret for parent session authorization handshakes
PARENT_APP_AUTH_SECRET="vtu-parent-app-auth-signature-secret-key-2026"

# Secret authorized admin key required for student facial enrollment and mutation endpoints
ENROLLMENT_ADMIN_KEY="vtu-enrollment-administrator-authorized-key-2026"

# Cosine similarity matching threshold (Empirically calibrated to 0.40)
ARCFACE_COSINE_THRESHOLD="0.40"

# 4. Server & Storage Configuration
NODE_ENV="production"
PORT=3000
APP_URL="http://localhost:3000"
PRIVATE_UPLOAD_DIR=".private_uploads"

# 5. Email Delivery Service (Forgot Password OTP)
# If unconfigured, the system safely logs the 6-digit OTP verification codes to the server console in dev mode.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="VTU Smart Attendance <no-reply@vtu.ac.in>"
# SMTP_SECURE="false"
