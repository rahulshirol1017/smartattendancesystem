# Optional MongoDB Atlas connection string.
# When MONGODB_URI is provided, the Express server persists all collections in MongoDB via Mongoose.
# When omitted, the server automatically runs in local persistent Demonstration & Sandbox Mode.
MONGODB_URI=""

# Secret used to sign HTTP-only session cookies and authorization tokens.
JWT_SECRET="replace-with-secure-institutional-jwt-secret"

# Private directory path for storing uploaded attendance correction supporting documents.
PRIVATE_UPLOAD_DIR=".private_uploads"

# APP_URL injected at runtime
APP_URL="http://localhost:3000"
